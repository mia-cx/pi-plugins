{
	"name": "@mia-cx/pi-plugins",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Mia's pi plugins: OptMem memory, /usage limits, a statusline, and the Nightshade theme.",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"repository": "github:mia-cx/pi-plugins",
	"packageManager": "pnpm@11.25.0",
	"pi": {
		"extensions": [
			"./extensions/*/index.ts"
		],
		"themes": [
			"./themes/*.json"
		]
	},
	"scripts": {
		"check": "biome check && tsc --noEmit",
		"format": "biome check --write"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-coding-agent": "1.5.2",
		"@earendil-works/pi-tui": "1.5.2",
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2"
	}
}
